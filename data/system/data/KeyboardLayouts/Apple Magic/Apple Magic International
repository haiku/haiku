name = Apple Magic International

# Size shortcuts
default-size = 10,10
$l = 4,10
$esc = 17,10
$back = 17,10
$lshift = 13,10
$b = 2,12
$d = 15,10
$e = l12,20,8
$f = 10,20
$two = 20,10
$last = 10,12
$cmd = 14,12
$arrow = 10,6

# Key rows
[ 0,0;  $l:-; $esc:0x01; :+12; ]
[ 0,10; $l:-; :0x11+12; $back:+; ]
[ 0,20; $l:-; $d:0x26; :+12; $e:0x47; ]
[ 0,30; $l:led-caps; # integrated into caps key
	17,10:0x3b; :+11; :0x33; ]
[ 0,40; $l:-; $lshift:0x4b; :0x69; :0x4c+9; 24,10:+1; ]
[ 0,50; $l:-; $last:-; # fn key
	$last:0x5c; $last:0x5d; $cmd:0x66; 49,12:0x5e; $cmd:0x67; 
	$last:0x5f; $arrow:-; $arrow:0x57; $arrow:-; ]
[ 121,56; $arrow:0x61+2; ]
