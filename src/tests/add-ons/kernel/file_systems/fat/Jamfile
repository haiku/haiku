SubDir HAIKU_TOP src tests add-ons kernel file_systems fat ;

include [ FDirName $(HAIKU_TOP) src add-ons kernel file_systems fat JamCommon ] ;

SEARCH_SOURCE += $(fatTop) ;
SEARCH_SOURCE += [ FDirName $(fatTop) bsd fs msdosfs ] ;

local defines = [ FDefines TEST USER=1 ] ;
