# Generated source files

local genServerRepositoryGenFiles =
	DumpExportRepositoryModel.cpp DumpExportRepositoryJsonListener.cpp ;
local genServerPkgGenFiles =
	DumpExportPkgModel.cpp DumpExportPkgJsonListener.cpp ;
local genServerReferenceGenFiles =
	DumpExportReferenceModel.cpp DumpExportReferenceJsonListener.cpp ;

Application HaikuDepot
	:
	$(applicationSources)
	$(textDocumentSources)
	$(genServerPkgGenFiles)
	$(genServerRepositoryGenFiles)
	$(genServerReferenceGenFiles)
	:
	be package bnetapi translation libnetservices.a libcolumnlistview.a shared
	[ TargetLibstdc++ ] [ TargetLibsupc++ ] localestub
	:
	HaikuDepot.rdef
;

DoCatalogs HaikuDepot :
	x-vnd.Haiku-HaikuDepot
	:
	$(applicationSources)
;

# Configuration of the code generation of schemas. The `sourcesDependentOnGen` is excessive in that
# it makes all of the Application's sources dependent on the generated sources which is not the
# case, but to isolate specific sources and maintain that list is likely quite difficult over time.

local sourcesDependentOnGen =
	[ FGristFiles $(applicationSources) ] [ FGristFiles $(applicationSources:S=.h) ] ;

JsonSchemaModelAndParser
	$(genServerRepositoryGenDirectory)
	: $(genServerRepositoryGenFiles)
	: $(sourcesDependentOnGen)
	: [ FDirName $(SUBDIR) server schema dumpexportrepository.json ]
;
JsonSchemaModelAndParser
	$(genServerPkgGenDirectory)
	: $(genServerPkgGenFiles)
	: $(sourcesDependentOnGen)
	: [ FDirName $(SUBDIR) server schema dumpexportpkg.json ]
;
JsonSchemaModelAndParser
	$(genServerReferenceGenDirectory)
	: $(genServerReferenceGenFiles)
	: $(sourcesDependentOnGen)
	: [ FDirName $(SUBDIR) server schema dumpexportreference.json ]
;