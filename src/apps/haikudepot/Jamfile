SubDir HAIKU_TOP src apps haikudepot ;

# disable -Werror for this directory only
SubDirC++Flags -Wno-error ;

include [ FDirName $(SUBDIR) build jam JsonSchemaGenRules ] ;

UsePrivateHeaders interface net netservices package shared storage ;
UsePrivateHeaders support locale ;

HAIKUDEPOT_GENERATED_SOURCES_DIRECTORY = $(TARGET_COMMON_DEBUG_LOCATE_TARGET) ;

# Directories where generated sources will be written.

local genServerRepositoryGenDirectory =
	[ FDirName $(HAIKUDEPOT_GENERATED_SOURCES_DIRECTORY) dumpexportrepository ] ;
local genServerPkgGenDirectory =
	[ FDirName $(HAIKUDEPOT_GENERATED_SOURCES_DIRECTORY) dumpexportpkg ] ;
local genServerReferenceGenDirectory =
	[ FDirName $(HAIKUDEPOT_GENERATED_SOURCES_DIRECTORY) dumpexportreference ] ;

# source directories
