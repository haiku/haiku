	server
	tar
	util
;

local sourceDir ;
for sourceDir in $(sourceDirs) {
	SEARCH_SOURCE += [ FDirName $(SUBDIR) $(sourceDir) ] ;
}

SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src servers package ] ;

SEARCH_SOURCE += $(genServerRepositoryGenDirectory) ;
SEARCH_SOURCE += $(genServerPkgGenDirectory) ;
SEARCH_SOURCE += $(genServerReferenceGenDirectory) ;

